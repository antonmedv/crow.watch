{{ define "title" }}Moderate {{ .Username }} | Crow Watch{{ end }}

{{ define "head" }}
  <style>
    .mod-section {
      margin-bottom: 32px;
    }
    .mod-section h2 {
      font-size: 18px;
      margin-bottom: 12px;
    }
    .mod-section hr {
      margin: 24px 0;
      border: none;
      border-top: 1px solid var(--border);
    }
    .mod-user-info {
      color: var(--text-muted);
      font-size: 0.85rem;
      margin-bottom: 24px;
    }
    .mod-user-info span:not(:last-child)::after {
      content: "\00b7";
      margin: 0 0.4em;
    }
    .mod-ban-reason {
      padding: 8px 12px;
      border-radius: 4px;
      margin-bottom: 12px;
      font-size: 14px;
    }
    .mod-ban-reason strong {
      color: #c00;
    }
    .mod-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
      margin-bottom: 16px;
    }
    .mod-table th,
    .mod-table td {
      padding: 6px 12px;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }
    .mod-table th {
      font-weight: 600;
      color: var(--text-muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .mod-table code {
      font-size: 13px;
    }
    .btn--danger {
      background: #c00;
      border-color: #c00;
      color: #fff;
    }
  </style>
{{ end }}

{{ define "content" }}
  <h1 class="page-title">
    Moderate <a href="/u/{{ .Username }}">{{ .Username }}</a>
  </h1>

  <div class="mod-user-info">
    <span
      >{{ .StoryCount }}
      {{ if eq .StoryCount 1 }}story{{ else }}stories{{ end }}</span
    >
    <span
      >{{ .CommentCount }}
      {{ if eq .CommentCount 1 }}comment{{ else }}comments{{ end }}</span
    >
    <span>member since {{ .CreatedAt.Format "Jan 2006" }}</span>
    {{ if .IsModerator }}<span>moderator</span>{{ end }}
  </div>

  <div class="mod-user-info">
    <span>{{ .Email }}{{ if .EmailConfirmed }} (confirmed){{ else }} (unconfirmed){{ end }}</span>
    {{ if .Campaign }}<span>campaign: {{ .Campaign }}</span>{{ end }}
  </div>

  {{ if .IPs }}
    <h2 style="font-size: 16px; margin-bottom: 8px;">IP Addresses</h2>
    <table class="mod-table">
      <thead>
        <tr>
          <th>IP</th>
          <th>Action</th>
          <th>Hits</th>
          <th>Last seen</th>
        </tr>
      </thead>
      <tbody>
        {{ range .IPs }}
          <tr>
            <td><code>{{ .IP }}</code></td>
            <td>{{ .Action }}</td>
            <td>{{ .HitCount }}</td>
            <td>{{ timeAgo .LastSeen }}</td>
          </tr>
        {{ end }}
      </tbody>
    </table>
  {{ end }}

  {{ if .SharedIPUsers }}
    <h2 style="font-size: 16px; margin: 16px 0 8px;">Users Sharing IPs</h2>
    <table class="mod-table">
      <thead>
        <tr>
          <th>IP</th>
          <th>User</th>
          <th>Campaign</th>
          <th>Joined</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {{ range .SharedIPUsers }}
          <tr>
            <td><code>{{ .IP }}</code></td>
            <td><a href="/u/{{ .Username }}">{{ .Username }}</a></td>
            <td>{{ if .Campaign }}{{ .Campaign }}{{ else }}&mdash;{{ end }}</td>
            <td>{{ .CreatedAt.Format "Jan 2006" }}</td>
            <td>{{ if .IsBanned }}<span style="color: #c00;">banned</span>{{ else }}active{{ end }}</td>
          </tr>
        {{ end }}
      </tbody>
    </table>
  {{ end }}

  <div class="mod-section">
    {{ if .IsBanned }}
      <h2>User is Banned</h2>
      <div class="mod-ban-reason">
        <strong>Reason:</strong> {{ .BanReason }}
      </div>
      <form method="post" action="/mod/user/{{ .Username }}/unban">
        <button class="btn" type="submit">Unban User</button>
      </form>
    {{ else }}
      <h2>Ban User</h2>
      {{ if .IsModerator }}
        <p style="color: var(--text-muted);">Cannot ban a moderator.</p>
      {{ else }}
        <form method="post" action="/mod/user/{{ .Username }}/ban">
          <div class="field">
            <label for="ban-reason">Reason</label>
            <textarea
              id="ban-reason"
              name="reason"
              class="field-input"
              rows="2"
              maxlength="500"
              required
              placeholder="Why is this user being banned?"
            ></textarea>
          </div>
          <button class="btn btn--danger" type="submit">Ban User</button>
        </form>
      {{ end }}
    {{ end }}
    {{ if not .IsModerator }}
      <form
        method="post"
        action="/mod/user/{{ .Username }}/ban-purge"
        style="margin-top: 12px;"
        onsubmit="return confirm('Ban {{ .Username }} and HARD DELETE all their stories and comments? This cannot be undone.')"
      >
        <button class="btn btn--danger" type="submit">
          Ban and Delete All User's Content
        </button>
      </form>
    {{ end }}
  </div>

  <hr
    style="margin: 24px 0; border: none; border-top: 1px solid var(--border);"
  />

  <div class="mod-section">
    <h2>Remove Content</h2>
    {{ if gt .StoryCount 0 }}
      <form
        method="post"
        action="/mod/user/{{ .Username }}/delete-stories"
        style="margin-bottom: 12px;"
        onsubmit="return confirm('Remove all {{ .StoryCount }} stories by {{ .Username }}?')"
      >
        <button class="btn btn--danger" type="submit">
          Remove all stories ({{ .StoryCount }})
        </button>
      </form>
    {{ else }}
      <p style="color: var(--text-muted); margin-bottom: 12px;">
        No active stories.
      </p>
    {{ end }}
    {{ if gt .CommentCount 0 }}
      <form
        method="post"
        action="/mod/user/{{ .Username }}/delete-comments"
        onsubmit="return confirm('Remove all {{ .CommentCount }} comments by {{ .Username }}?')"
      >
        <button class="btn btn--danger" type="submit">
          Remove all comments ({{ .CommentCount }})
        </button>
      </form>
    {{ else }}
      <p style="color: var(--text-muted);">No active comments.</p>
    {{ end }}
  </div>
{{ end }}
